# ─────────────────────────────────────────────────────────────────────────────
# Bioinformatics Analytics Dashboard — Environment Configuration
# Copy this file to .env and fill in secrets.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
#  PROFILES
# ═════════════════════════════════════════════════════════════════════════════
SPRING_PROFILES_ACTIVE=dev

# ═════════════════════════════════════════════════════════════════════════════
#  SERVER PORTS
# ═════════════════════════════════════════════════════════════════════════════
SERVER_PORT_API_GATEWAY=8080
SERVER_PORT_AUTH_SERVICE=8081
SERVER_PORT_ANALYTICS_SERVICE=8082
SERVER_PORT_IMPORT_SERVICE=8083
SERVER_PORT_BACKEND=8084
SERVER_PORT_CONFIG_SERVER=8888
SERVER_PORT_DISCOVERY_SERVER=8761
SERVER_PORT_FRONTEND=80

# ═════════════════════════════════════════════════════════════════════════════
# Log folder
# ═════════════════════════════════════════════════════════════════════════════
LOG_PATH=logs

# ═════════════════════════════════════════════════════════════════════════════
#  POSTGRESQL
# ═════════════════════════════════════════════════════════════════════════════
POSTGRES_DB=bioinformatics_db
POSTGRES_USER=bio_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ═════════════════════════════════════════════════════════════════════════════
#  SPRING DATASOURCE (Dashboard / primary DB)
# ═════════════════════════════════════════════════════════════════════════════
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bioinformatics_db
SPRING_DATASOURCE_USERNAME=bio_user
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ═════════════════════════════════════════════════════════════════════════════
#  COMMON DATASOURCE (Auth-Service primary / replica)
# ═════════════════════════════════════════════════════════════════════════════
COMMON_DATASOURCE_PRIMARY_URL=jdbc:postgresql://postgres:5432/bioinformatics_db
COMMON_DATASOURCE_PRIMARY_USERNAME=bio_user
COMMON_DATASOURCE_PRIMARY_PASSWORD=change_me_in_production
COMMON_DATASOURCE_REPLICA_URL=jdbc:postgresql://postgres:5432/bioinformatics_db
COMMON_DATASOURCE_REPLICA_USERNAME=bio_user
COMMON_DATASOURCE_REPLICA_PASSWORD=change_me_in_production

# ═════════════════════════════════════════════════════════════════════════════
#  REDIS
# ═════════════════════════════════════════════════════════════════════════════
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# ═════════════════════════════════════════════════════════════════════════════
#  JWT (maps to app.jwt.*)
# ═════════════════════════════════════════════════════════════════════════════
APP_JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_JWT_ACCESS_TOKEN_EXPIRY_SECONDS=3600
APP_JWT_REFRESH_TOKEN_EXPIRY_SECONDS=604800

# ═════════════════════════════════════════════════════════════════════════════
#  DASHBOARD BUSINESS CONFIG (maps to app.*)
# ═════════════════════════════════════════════════════════════════════════════
APP_BATCH_CHUNK_SIZE=250
UNIPROT_API_BASE_URL=https://rest.uniprot.org
APP_IMPORT_CONFIG_TEMP_DIR=/tmp/.bio-import

# ═════════════════════════════════════════════════════════════════════════════
#  FILE UPLOAD
# ═════════════════════════════════════════════════════════════════════════════
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=2GB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=2GB

# ═════════════════════════════════════════════════════════════════════════════
#  EUREKA DISCOVERY
# ═════════════════════════════════════════════════════════════════════════════
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://discovery-server:8761/eureka/

# ═════════════════════════════════════════════════════════════════════════════
#  CONFIG SERVER
# ═════════════════════════════════════════════════════════════════════════════
SPRING_CLOUD_CONFIG_SERVER_GIT_URI=http://gitea-server:3000/bioinformatics/config-repo.git
SPRING_CLOUD_CONFIG_SERVER_GIT_USERNAME=config-user
SPRING_CLOUD_CONFIG_SERVER_GIT_PASSWORD=change_me_in_production
ENCRYPT_KEY=Change_Me_In_Production_32CharKey!!

# ═════════════════════════════════════════════════════════════════════════════
#  GITEA
# ═════════════════════════════════════════════════════════════════════════════
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change_me_in_production
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222

# ═════════════════════════════════════════════════════════════════════════════
#  FRONTEND
# ═════════════════════════════════════════════════════════════════════════════
ANGULAR_API_BASE_URL=http://api-gateway:8080
