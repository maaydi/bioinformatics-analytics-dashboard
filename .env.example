# ─────────────────────────────────────────────────────────────────────────────
# Bioinformatics Analytics Dashboard — Environment Configuration
# Copy this file to .env and fill in secrets.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════════════
#  PROFILES
# ═════════════════════════════════════════════════════════════════════════════
# Used by locally run Spring applications; Compose pins prod for container networking.
SPRING_PROFILES_ACTIVE=dev

# ═════════════════════════════════════════════════════════════════════════════
#  SERVER PORTS
# ═════════════════════════════════════════════════════════════════════════════
SERVER_PORT_API_GATEWAY=8080
SERVER_PORT_AUTH_SERVICE=8081
SERVER_PORT_ANALYTICS_SERVICE=8082
SERVER_PORT_IMPORT_SERVICE=8083
SERVER_PORT_BACKEND=8084
SERVER_PORT_EXPORT_SERVICE=8085
SERVER_PORT_AUDIT_SERVICE=8089
SERVER_PORT_CONFIG_SERVER=8888
SERVER_PORT_DISCOVERY_SERVER=8761
SERVER_PORT_FRONTEND=80
ZIPKIN_PORT=9411

# ═════════════════════════════════════════════════════════════════════════════
# Log folder
# ═════════════════════════════════════════════════════════════════════════════
LOG_PATH=logs

# ═════════════════════════════════════════════════════════════════════════════
#  POSTGRESQL
# ═════════════════════════════════════════════════════════════════════════════
POSTGRES_DB=bioinformatics_db
POSTGRES_USER=bio_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433

# ═════════════════════════════════════════════════════════════════════════════
#  SPRING DATASOURCE (Dashboard / primary DB)
# ═════════════════════════════════════════════════════════════════════════════
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bioinformatics_db
SPRING_DATASOURCE_USERNAME=bio_user
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# ═════════════════════════════════════════════════════════════════════════════
#  COMMON DATASOURCE (Auth-Service primary / replica)
# ═════════════════════════════════════════════════════════════════════════════
COMMON_DATASOURCE_PRIMARY_URL=jdbc:postgresql://postgres:5432/bioinformatics_db
COMMON_DATASOURCE_PRIMARY_USERNAME=bio_user
COMMON_DATASOURCE_PRIMARY_PASSWORD=change_me_in_production
COMMON_DATASOURCE_REPLICA_URL=jdbc:postgresql://postgres-replica:5432/bioinformatics_db
COMMON_DATASOURCE_REPLICA_USERNAME=bio_user
COMMON_DATASOURCE_REPLICA_PASSWORD=change_me_in_production

# ═════════════════════════════════════════════════════════════════════════════
#  REDIS
# ═════════════════════════════════════════════════════════════════════════════
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production

# ═════════════════════════════════════════════════════════════════════════════
#  SHARED KAFKA / AUDIT PUBLISHERS
# ═════════════════════════════════════════════════════════════════════════════
# Docker-internal listener, used by all six business services for common.kafka.*.
# Compose also maps this value to Spring Kafka's broker setting.
COMMON_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Optional app.audit-pool.* overrides, passed to every business service via env_file.
# Leave unset to retain service-specific sizes and thread-name prefixes from Config Server:
# dashboard/audit: core=1, max=10, queue=25; auth/analytics/import/export: core=1, max=5, queue=50.
# APP_AUDIT_POOL_CORE_SIZE=1
# APP_AUDIT_POOL_MAX_SIZE=10
# APP_AUDIT_POOL_QUEUE_CAPACITY=50
# APP_AUDIT_POOL_THREAD_NAME_PREFIX=audit-

# ═════════════════════════════════════════════════════════════════════════════
#  SERVLET API RATE LIMITS (maps to app.rate-limiter.*)
# ═════════════════════════════════════════════════════════════════════════════
# Passed to all six business services via env_file; named policies stay in backend-config.
# Budgets are per policy/client IP/service instance, not distributed Gateway quotas.
# Capacity is the initial burst; tokens refill greedily over seconds.
APP_RATE_LIMITER_ENABLED=true
APP_RATE_LIMITER_GLOBAL_CAPACITY=100
APP_RATE_LIMITER_GLOBAL_TOKENS=100
APP_RATE_LIMITER_GLOBAL_SECONDS=60

# Dashboard discovery and audit-history search; count shares the search budget.
APP_RATE_LIMITER_SEARCH_CAPACITY=30
APP_RATE_LIMITER_SEARCH_TOKENS=30
APP_RATE_LIMITER_SEARCH_SECONDS=60
APP_RATE_LIMITER_DETAIL_CAPACITY=60
APP_RATE_LIMITER_DETAIL_TOKENS=60
APP_RATE_LIMITER_DETAIL_SECONDS=60
APP_RATE_LIMITER_AUTOCOMPLETE_CAPACITY=120
APP_RATE_LIMITER_AUTOCOMPLETE_TOKENS=120
APP_RATE_LIMITER_AUTOCOMPLETE_SECONDS=60

# Authentication and privileged credential operations.
APP_RATE_LIMITER_LOGIN_CAPACITY=10
APP_RATE_LIMITER_LOGIN_TOKENS=10
APP_RATE_LIMITER_LOGIN_SECONDS=60
APP_RATE_LIMITER_REFRESH_CAPACITY=20
APP_RATE_LIMITER_REFRESH_TOKENS=20
APP_RATE_LIMITER_REFRESH_SECONDS=60
APP_RATE_LIMITER_LOGOUT_CAPACITY=30
APP_RATE_LIMITER_LOGOUT_TOKENS=30
APP_RATE_LIMITER_LOGOUT_SECONDS=60
APP_RATE_LIMITER_CHANGE_PASSWORD_CAPACITY=5
APP_RATE_LIMITER_CHANGE_PASSWORD_TOKENS=5
APP_RATE_LIMITER_CHANGE_PASSWORD_SECONDS=60
APP_RATE_LIMITER_SERVICE_TOKEN_CAPACITY=5
APP_RATE_LIMITER_SERVICE_TOKEN_TOKENS=5
APP_RATE_LIMITER_SERVICE_TOKEN_SECONDS=60

# Job creation/retry, downloads and high-frequency status polling.
APP_RATE_LIMITER_IMPORT_CAPACITY=5
APP_RATE_LIMITER_IMPORT_TOKENS=5
APP_RATE_LIMITER_IMPORT_SECONDS=60
APP_RATE_LIMITER_EXPORT_CAPACITY=10
APP_RATE_LIMITER_EXPORT_TOKENS=10
APP_RATE_LIMITER_EXPORT_SECONDS=60
APP_RATE_LIMITER_DOWNLOAD_CAPACITY=20
APP_RATE_LIMITER_DOWNLOAD_TOKENS=20
APP_RATE_LIMITER_DOWNLOAD_SECONDS=60
APP_RATE_LIMITER_STATUS_CAPACITY=120
APP_RATE_LIMITER_STATUS_TOKENS=120
APP_RATE_LIMITER_STATUS_SECONDS=60

# Cached/filtered chart fan-out and expensive two-subset comparisons.
APP_RATE_LIMITER_ANALYTICS_CAPACITY=120
APP_RATE_LIMITER_ANALYTICS_TOKENS=120
APP_RATE_LIMITER_ANALYTICS_SECONDS=60
APP_RATE_LIMITER_ANALYSIS_CAPACITY=60
APP_RATE_LIMITER_ANALYSIS_TOKENS=60
APP_RATE_LIMITER_ANALYSIS_SECONDS=60
APP_RATE_LIMITER_COMPARE_CAPACITY=10
APP_RATE_LIMITER_COMPARE_TOKENS=10
APP_RATE_LIMITER_COMPARE_SECONDS=60

# ═════════════════════════════════════════════════════════════════════════════
#  JWT (maps to app.jwt.*)
# ═════════════════════════════════════════════════════════════════════════════
APP_JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
APP_JWT_ACCESS_TOKEN_EXPIRY_SECONDS=3600
APP_JWT_REFRESH_TOKEN_EXPIRY_SECONDS=604800

# ═════════════════════════════════════════════════════════════════════════════
#  DASHBOARD BUSINESS CONFIG (maps to app.*)
# ═════════════════════════════════════════════════════════════════════════════
APP_BATCH_CHUNK_SIZE=250
UNIPROT_API_BASE_URL=https://rest.uniprot.org
APP_IMPORT_CONFIG_TEMP_DIR=/app/bio-import
APP_EXPORT_TEMP_DIR=/app/bio-export

# ═════════════════════════════════════════════════════════════════════════════
#  FILE UPLOAD
# ═════════════════════════════════════════════════════════════════════════════
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=2GB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=2GB

# ═════════════════════════════════════════════════════════════════════════════
#  EUREKA DISCOVERY
# ═════════════════════════════════════════════════════════════════════════════
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://discovery-server:8761/eureka/

# ═════════════════════════════════════════════════════════════════════════════
#  CONFIG SERVER
# ═════════════════════════════════════════════════════════════════════════════
SPRING_CLOUD_CONFIG_SERVER_GIT_URI=http://gitea-server:3000/bioinformatics/config-repo.git
SPRING_CLOUD_CONFIG_SERVER_GIT_USERNAME=config-user
SPRING_CLOUD_CONFIG_SERVER_GIT_PASSWORD=change_me_in_production
ENCRYPT_KEY=Change_Me_In_Production_32CharKey!!

# ═════════════════════════════════════════════════════════════════════════════
#  GITEA
# ═════════════════════════════════════════════════════════════════════════════
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=change_me_in_production
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222

# ═════════════════════════════════════════════════════════════════════════════
#  FRONTEND
# ═════════════════════════════════════════════════════════════════════════════
ANGULAR_API_BASE_URL=http://api-gateway:8080
