# ──────────────────────────────────────────────
# Bioinformatics Analytics Dashboard
# Copy this file to .env and fill in secrets.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# Application data directory
APP_DIR=$HOME

# ── PostgreSQL ─────────────────────────────────
POSTGRES_DB=bioinformatics_db
POSTGRES_USER=bio_user
POSTGRES_PASSWORD=change_me_in_production

# ── Backend Spring Boot ────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/bioinformatics_db
SPRING_DATASOURCE_USERNAME=bio_user
SPRING_DATASOURCE_PASSWORD=change_me_in_production

# JWT — must be a strong random secret (≥ 256 bits)
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=86400

# Spring Batch chunk size (default: 250)
BATCH_CHUNK_SIZE=250

# File upload max size (Spring multipart)
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=2GB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=2GB

# ── Frontend (build-time) ──────────────────────
ANGULAR_API_BASE_URL=http://localhost:8080

# ── Dev ports (docker compose) ─────────────────
BACKEND_PORT=8080
FRONTEND_PORT=80
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password_to_be_changed

# Gitea
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=password_to_be_changed
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=222

# Config Server
CONFIG_SERVER_PORT=8888
CONFIG_ENCRYPT_KEY=Change_Me_In_Production-32CharKey
# Instantiate Gitea with docker compose up gitea-db gitea-server
# Connect to it localhost:3000
# Then configure user and password and keep it here
# to be used with services to load configuration
GITEA_CONFIG_USER=config-user
GITEA_CONFIG_PASSWORD=password_to_be_set

