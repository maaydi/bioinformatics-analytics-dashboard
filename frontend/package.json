    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "playwright": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "zone.js": "~0.15.0"
